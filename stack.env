# =============================================================================
# b2bimg — esempio di configurazione
# Copia in `.env` (git-ignorato) e adatta i valori. NESSUN segreto va nel codice.
# =============================================================================

# --- Server ------------------------------------------------------------------
# 127.0.0.1 = solo locale (default consigliato senza reverse proxy).
# In Docker l'app riceve APP_HOST=0.0.0.0 dal docker-compose, ma la porta è
# pubblicata solo su 127.0.0.1.
APP_HOST=127.0.0.1
APP_PORT=8001
LOG_LEVEL=INFO
# Host ammessi (anti Host-header). Usa "*" solo in locale; in produzione es.
# TRUSTED_HOST=immagini.interna.local,localhost,127.0.0.1
TRUSTED_HOST=*

# --- Sicurezza / sessione ----------------------------------------------------
# Genera con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiami-con-una-stringa-casuale-lunga

# Utente amministratore creato al primo avvio (nessuna registrazione pubblica).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiami
SESSION_TTL_MINUTES=480
# Metti true solo dietro HTTPS (reverse proxy con TLS).
SESSION_COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- Storage / limiti --------------------------------------------------------
DATA_DIR=data
MAX_UPLOAD_MB=20
MAX_IMAGE_MB=25
# Per passare a PostgreSQL (opzionale, futuro):
# DATABASE_URL=postgresql+psycopg://utente:password@db:5432/b2bimg

# --- Sorgenti ----------------------------------------------------------------
# Richieste max per minuto verso ciascuna sorgente esterna (anti-abuso).
SOURCE_RATE_LIMIT_PER_MIN=30
SOURCE_DEFAULT_TIMEOUT=15
SOURCE_MAX_RETRIES=3
JOB_ROW_BATCH=100

# --- Credenziali sorgenti/destinazioni (referenziate come ${VAR} nei form) ---
# Cookie di sessione di un portale esterno (session reuse). Esistono due modi:
#   1) variabile d'ambiente con l'intero header Cookie
SORGENTE_HTTP_COOKIE=sessionid=xxxxxxxx; csrftoken=yyyyyyyy
#   2) file di testo con l'header Cookie nella prima riga (aggiornabile a caldo)
# COOKIE_FILE=/data/cookies/portale.txt

# SFTP (sorgente e/o destinazione)
SFTP_PASSWORD=cambiami
# SFTP_KEY_FILE=/data/keys/id_ed25519

# S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
